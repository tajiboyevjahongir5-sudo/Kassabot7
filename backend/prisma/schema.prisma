generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id // Telegram user ID as string
  username  String?
  firstName String?
  subs      Subscription[]
  payments  Payment[]
}

model Channel {
  id        String   @id // Telegram chat ID as string
  title     String
  image     String?  // Base64 or URL
  adminId   String
  isDeleted Boolean  @default(false)
  plans     Plan[]
  subs      Subscription[]
}

model Plan {
  id          Int      @id @default(autoincrement())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id])
  name        String
  description String?
  price       Int      // Price
  priceType   String   @default("UZS") // Changed to UZS
  duration    Int      // Duration in days
  isDeleted   Boolean  @default(false)
  payments    Payment[]
}

model Subscription {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id])
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED
  expiresAt   DateTime

  @@index([userId, status])
  @@index([status, expiresAt])
}

model Settings {
  id                      Int     @id @default(1)
  paymentChannelId        String?
  rubRate                 Float   @default(155)
  joinRequestChannelId    String? // Maxfiy kanal ID (masalan: -100xxx)
  joinRequestLink         String? // Kanalga havola (masalan: https://t.me/+abc)
  joinRequestMessage      String? // Foydalanuvchiga yuboriladigan xabar (caption)
  joinRequestMediaType    String? // "photo", "video", "animation" yoki null (faqat matn)
  joinRequestMediaFileId  String? // Telegram file_id
  clickP2pUrl             String? // Click P2P to'lov havolasi (masalan: https://my.click.uz/clickp2p/...)
}

model MandatoryChannel {
  id          Int      @id @default(autoincrement())
  channelId   String   @unique  // Telegram channel/group ID (e.g. -100xxx) or @username. For bots, this is the Log Channel ID.
  title       String            // Display name
  inviteLink  String?           // Optional invite link shown to user
  type        String   @default("CHANNEL") // "CHANNEL" or "BOT"
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model BotSubscriber {
  id           Int      @id @default(autoincrement())
  userId       String
  logChannelId String
  createdAt    DateTime @default(now())

  @@unique([userId, logChannelId])
}

model JoinRequest {
  id        Int      @id @default(autoincrement())
  userId    String
  channelId String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())

  @@unique([userId, channelId])
  @@index([channelId, status])
}

model Card {
  id             Int      @id @default(autoincrement())
  slot           Int      @unique // 1..10, determines rotation order
  cardNumber     String
  cardHolder     String   @default("")
  bankName       String   @default("")
  clickP2pUrl    String?  // Har bir karta uchun alohida Click P2P havolasi
  transferCount  Int      @default(0)
  maxTransfers   Int      @default(40)
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  planId      Int
  plan        Plan     @relation(fields: [planId], references: [id])
  amount      Int      // Exact amount to pay including the random suffix
  status      String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  promoCode   String?  // Applied promo code

  @@index([status])
  @@index([userId])
}

model PromoCode {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  discountType  String   @default("percent") // percent or fixed
  discountValue Int      // e.g. 20 for 20% or 5000 for 5000 UZS off
  maxUses       Int      @default(0) // 0 = unlimited
  usedCount     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}
